---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="utility-strip">
    <div class="wrap utility-inner">
      <span>{site.shortName.toUpperCase()} / PORTFOLIO {site.footer.year}</span>
      <span>BANDUNG, ID / {site.timezone}</span>
    </div>
  </div>

  <div class="wrap header-inner">
    <a class="brand" href="#top" aria-label={`${site.shortName} — back to top`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-word">{site.shortName}</span>
    </a>

    <nav class="header-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          site.nav.map((item, index) => (
            <li>
              <a href={item.href} data-nav-link>
                <span class="nav-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        title="Toggle theme"
      >
        <span class="sr-only theme-toggle-label theme-toggle-label--to-light"
          >Switch to light theme</span
        >
        <span class="sr-only theme-toggle-label theme-toggle-label--to-dark"
          >Switch to dark theme</span
        >
        <svg
          class="theme-icon-moon"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M13.5 9.6A5.9 5.9 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linejoin="round"
          ></path>
        </svg>
        <svg
          class="theme-icon-sun"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <circle
            cx="8"
            cy="8"
            r="3"
            stroke="currentColor"
            stroke-width="1.25"
          ></circle>
          <path
            d="M8 1v2M8 13v2M1 8h2M13 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>

      <a
        class="header-email"
        href={site.links.email.href}
        aria-label={`Email ${site.name}`}
      >
        Email
        <svg
          class="icon"
          viewBox="0 0 12 12"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="square"
          ></path>
        </svg>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle-label">Menu</span>
        <svg
          class="menu-icon"
          viewBox="0 0 16 10"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <path class="menu-line menu-line-top" d="M0 1h16" />
          <path class="menu-line menu-line-bottom" d="M0 9h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="menu-panel" id="mobile-menu" data-menu-panel>
    <nav class="menu-nav" aria-label="Mobile">
      <ul>
        {
          site.nav.map((item, index) => (
            <li>
              <a href={item.href} data-nav-link>
                <span class="nav-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-meta">
      <a href={site.links.email.href}>Email</a>
      <a
        href={site.links.github.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a
        href={site.links.linkedin.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    <p class="menu-availability">
      <span class="availability-dot" aria-hidden="true"></span>
      {site.hero.availability}
    </p>
  </div>
</header>

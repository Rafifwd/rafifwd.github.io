---
import { site } from "../data/site";

const lines = site.hero.terminal;
---

<div class="terminal" role="group" aria-label="Terminal summary">
  <div class="terminal-bar" aria-hidden="true">
    <span class="terminal-dot"></span>
    <span class="terminal-dot"></span>
    <span class="terminal-dot"></span>
    <span class="terminal-title">rafif@bandung: ~</span>
  </div>

  <div class="terminal-body">
    {
      lines.map((line, index) => (
        <div class="terminal-line">
          <span class="terminal-prompt" aria-hidden="true">$</span>
          <span class="terminal-key">{line.command}</span>
          <span class="terminal-arrow" aria-hidden="true">→</span>
          <span
            class:list={[
              "terminal-value",
              { "terminal-status": index === lines.length - 1 },
            ]}
          >
            {line.value}
            {index === lines.length - 1 && (
              <span class="cursor" aria-hidden="true" />
            )}
          </span>
        </div>
      ))
    }
  </div>
</div>

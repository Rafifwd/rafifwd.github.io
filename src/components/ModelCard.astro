---
import { site } from "../data/site";

const { model } = site.hero;
---

<aside class="model-card" aria-labelledby="model-card-label">
  <div class="model-card-top">
    <span class="model-card-label" id="model-card-label">{model.label}</span>
    <span class="model-card-year">{model.year}</span>
  </div>

  <dl class="model-facts">
    {
      model.rows.map((row) => (
        <div class="model-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="model-card-footer">
    <svg
      class="model-pipeline"
      viewBox="0 0 420 52"
      role="img"
      aria-labelledby="pipeline-title pipeline-desc"
    >
      <title id="pipeline-title">Model pipeline</title>
      <desc id="pipeline-desc">
        Data flows through a model, then an explanation layer, then the
        interface. The explanation stage is highlighted.
      </desc>

      <g class="pipe-rules">
        <line x1="40" y1="11" x2="104" y2="11"></line>
        <line x1="150" y1="11" x2="216" y2="11"></line>
        <line x1="272" y1="11" x2="332" y2="11"></line>
      </g>
      <g class="pipe-arrows" aria-hidden="true">
        <path d="M98 7l6 4-6 4"></path>
        <path d="M210 7l6 4-6 4"></path>
        <path d="M326 7l6 4-6 4"></path>
      </g>

      <g class="pipe-labels">
        <text x="7" y="38">{model.pipeline[0]}</text>
        <text x="112" y="38">{model.pipeline[1]}</text>
        <text x="224" y="38" class="pipe-label-accent">{model.pipeline[2]}</text>
        <text x="340" y="38">{model.pipeline[3]}</text>
      </g>
    </svg>

    <p class="model-card-caption">{model.caption}</p>
  </div>
</aside>

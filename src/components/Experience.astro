---
import { site } from "../data/site";
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head-main">
        <p class="section-label">
          <span class="section-label-num">04</span>
          <span aria-hidden="true">/</span>
          Experience
        </p>
        <h2 id="experience-title">The product and ops side</h2>
      </div>
      <p class="section-note">
        Leadership and operations work that shaped how I build with teams.
      </p>
    </div>

    <div class="experience-head" aria-hidden="true">
      <span>Period</span>
      <span>Role / Org</span>
      <span>Contribution</span>
      <span>Location</span>
    </div>

    <ol class="experience-list">
      {
        site.experience.map((item) => (
          <li class:list={["experience-row", { "is-current": item.current }]}>
            <p class="experience-dates">{item.dates}</p>

            <div class="experience-main">
              <h3>
                {item.title}
                {item.current && <span class="current-tag">Current</span>}
              </h3>
              <p class="experience-org">{item.org}</p>
            </div>

            <p class="experience-contribution">{item.contribution}</p>
            <p class="experience-location">{item.location}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

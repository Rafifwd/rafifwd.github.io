---
import { site } from "../data/site";
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div class="section-head-main">
        <p class="section-label">
          <span class="section-label-num">03</span>
          <span aria-hidden="true">/</span>
          Experience
        </p>
        <h2 id="experience-title">The product and ops side</h2>
      </div>
      <p class="section-note">
        Leadership and operations work that shaped how I build with teams.
      </p>
    </div>

    <ol class="experience-list">
      {
        site.experience.map((item, index) => (
          <li
            class:list={["experience-row", { "is-current": item.current }]}
            data-reveal
            style={`--i: ${index}`}
          >
            <p class="experience-dates">{item.dates}</p>

            <div class="experience-main">
              <h3>
                {item.title}
                {item.current && <span class="current-tag">Current</span>}
              </h3>
              <p class="experience-org">
                <span>{item.org}</span>
                <span class="experience-sep" aria-hidden="true">·</span>
                <span>{item.location}</span>
              </p>
            </div>

            <p class="experience-contribution">{item.contribution}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import { site } from "../data/site";
import ProjectFigure from "./ProjectFigure.astro";

const buildCount = String(site.projects.length).padStart(2, "0");
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head-main">
        <p class="section-label">
          <span class="section-label-num">02</span>
          <span aria-hidden="true">/</span>
          Selected work
        </p>
        <h2 id="work-title">Things built end to end</h2>
      </div>
      <p class="section-note">
        Three recent builds across AI/ML systems and the product interfaces
        around them.
      </p>
      <p class="section-count">{buildCount} builds</p>
    </div>

    <div class="projects">
      {
        site.projects.map((project) => (
          <article
            class="project"
            id={project.slug}
            aria-labelledby={`${project.slug}-title`}
          >
            <div class="project-top">
              <span class="project-index">{project.index}</span>

              <h3 class="project-title" id={`${project.slug}-title`}>
                {project.live ? (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.title}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  project.title
                )}
              </h3>

              <span class="project-year">{project.year}</span>
              <span class="project-role">{project.role}</span>
            </div>

            <div class="project-bottom">
              <div class="project-body">
                <p class="project-description">{project.description}</p>

                <ul class="project-stack" aria-label={`${project.title} stack`}>
                  {project.stack.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>

                {project.live && (
                  <a
                    class="project-live"
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Live demo
                    <svg
                      class="icon"
                      viewBox="0 0 12 12"
                      fill="none"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
                        stroke="currentColor"
                        stroke-width="1.25"
                        stroke-linecap="square"
                      />
                    </svg>
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </div>

              <div class="project-plate">
                <ProjectFigure
                  index={project.index}
                  label={project.figure}
                  slug={project.slug}
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

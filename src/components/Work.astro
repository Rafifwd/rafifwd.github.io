---
import { site } from "../data/site";
import ProjectFigure from "./ProjectFigure.astro";
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div class="section-head-main">
        <p class="section-label">
          <span class="section-label-num">01</span>
          <span aria-hidden="true">/</span>
          Selected work
        </p>
        <h2 id="work-title">Things built end to end</h2>
      </div>
      <p class="section-note">
        Three recent builds across AI/ML systems and the product interfaces
        around them.
      </p>
    </div>

    <div class="projects">
      {
        site.projects.map((project, index) => (
          <article
            class:list={["project", { "project-reverse": index % 2 === 1 }]}
            id={project.slug}
            aria-labelledby={`${project.slug}-title`}
            data-reveal
            style={`--i: ${index}`}
          >
            <ProjectFigure
              index={project.index}
              label={project.figure}
              slug={project.slug}
            />

            <div class="project-body">
              <p class="project-meta">
                <span class="project-index">{project.index}</span>
                <span class="meta-sep" aria-hidden="true">/</span>
                <span>{project.role}</span>
                <span class="meta-sep" aria-hidden="true">/</span>
                <span>{project.year}</span>
              </p>

              <h3 class="project-title" id={`${project.slug}-title`}>
                {project.live ? (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.title}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  project.title
                )}
              </h3>

              <p class="project-description">{project.description}</p>

              <ul class="project-stack" aria-label={`${project.title} stack`}>
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>

              {project.live && (
                <a
                  class="project-live"
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live demo
                  <svg
                    class="icon"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
                      stroke="currentColor"
                      stroke-width="1.25"
                      stroke-linecap="square"
                    />
                  </svg>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

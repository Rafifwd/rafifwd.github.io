---
import { site } from "../data/site";
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="section-label">Selected work</p>
        <h2 id="work-title">Things built end to end</h2>
      </div>
      <p class="section-note">
        Three recent builds across AI/ML systems and the product interfaces
        around them.
      </p>
    </div>

    <div class="projects">
      {
        site.projects.map((project) => (
          <article
            class="project"
            id={project.slug}
            aria-labelledby={`${project.slug}-title`}
          >
            <span class="project-index" aria-hidden="true">
              {project.index}
            </span>

            <div>
              <h3 class="project-title" id={`${project.slug}-title`}>
                {project.live ? (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>

              <p class="project-description">{project.description}</p>

              <ul class="stack" aria-label={`${project.title} stack`}>
                {project.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>

            <div class="project-meta">
              <span class="project-role">{project.role}</span>
              <span>{project.year}</span>
              {project.live ? (
                <a
                  class="project-live"
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Live demo
                  <span class="arrow" aria-hidden="true">↗</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <span class="project-note">No public demo</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { site } from "../data/site";
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact-panel">
      <p class="section-label">Contact</p>
      <h2 id="contact-title">{site.contact.title}</h2>
      <p class="contact-copy">{site.contact.copy}</p>

      <a class="contact-cta" href={site.links.email.href}>
        <span>{site.email}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <div class="contact-links">
        <a
          class="external"
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a
          class="external"
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a href={site.links.email.href}>Email</a>
      </div>

      <p class="contact-meta">
        {site.location} <span aria-hidden="true">·</span>
        <span>{site.timezone}</span>
      </p>
    </div>
  </div>
</section>

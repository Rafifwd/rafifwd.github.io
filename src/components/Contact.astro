---
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="section-label section-label-ink" data-reveal>
      <span class="section-label-num">04</span>
      <span aria-hidden="true">/</span>
      Contact
    </p>

    <div class="contact-grid">
      <div class="contact-main" data-reveal style="--i: 1">
        <h2 id="contact-title">{site.contact.title}</h2>
        <p class="contact-copy">{site.contact.copy}</p>

        <a class="contact-email" href={site.links.email.href}>
          <span>{site.email}</span>
          <svg
            class="icon"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="square"
            ></path>
          </svg>
        </a>
      </div>

      <div class="contact-side" data-reveal style="--i: 2">
        <p class="contact-side-label">Elsewhere</p>

        <div class="contact-links">
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">
            GitHub
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a href={site.links.email.href}>Email</a>
        </div>

        <p class="contact-meta">
          {site.location}
          <span aria-hidden="true">·</span>
          <span>{site.timezone}</span>
        </p>
      </div>
    </div>
  </div>
</section>

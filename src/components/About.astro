---
import { site } from "../data/site";

const { about } = site;
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="section-head">
      <div class="section-head-main">
        <p class="section-label">
          <span class="section-label-num">03</span>
          <span aria-hidden="true">/</span>
          About
        </p>
        <h2 id="about-title">From model to product</h2>
      </div>
    </div>

    <div class="about-grid">
      <div class="about-copy">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <dl class="about-facts">
        {
          about.facts.map((fact) => (
            <div class="about-fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="capabilities">
      {
        about.capabilities.map((capability, index) => (
          <article class="capability">
            <span class="capability-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
            <ul>
              {capability.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
